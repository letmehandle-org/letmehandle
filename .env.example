# Copy to .env and fill in. Nothing in this file ever carries a real value — not a key, not
# an account identifier, not a phone number, not even a "harmless" one. See D-021.
#
# Every variable here is read by the typed settings object in the backend and validated at
# startup. A missing required variable stops the process with a message naming it, rather
# than failing later in a way that is hard to trace.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production. Guards behaviour that must never run in production,
# such as the mock one-time-password provider.
APP_ENV=development
# Host ports for the local stack. Change them if something else on your machine has them.
BACKEND_PORT=8000
POSTGRES_PORT=5432
LOG_LEVEL=info
# json in production, console in development.
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs access tokens, and keys the hash refresh tokens are stored under. At least 32
# characters. Generate a fresh one per deployment and never reuse one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it signs everybody out, which is the intended behaviour if it has leaked.
AUTH_SIGNING_KEY=

# How long an access token lives. Short on purpose: it cannot be revoked, because it is
# verified by signature rather than by a database lookup. Between 60 and 3600 seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# How long a refresh token lives. These can be revoked, and are rotated on every use.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Who delivers the sign-in code. `mock` delivers nowhere and records the code instead, which
# is what lets the project be run and tested without a paid account — and it refuses to start
# when APP_ENV is production, because it would let anybody sign in as anybody.
#
# There is no production-capable provider yet: the first arrives with the telephony work, and
# until then a production deployment is refused at startup rather than run unsafely.
OTP_PROVIDER=mock

# ---------------------------------------------------------------------------
# Privacy  (phase 8)
# ---------------------------------------------------------------------------
# Application-layer encryption keys for transcripts and call summaries (AES-256-GCM), as
# `id:key` pairs, comma-separated, NEWEST FIRST. An id is 1-16 lower-case letters, digits, -
# or _; a key is 32 random bytes in base64:
#
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Needed only by what stores or reads transcripts; migrations and the purge run without it.
# Losing every key makes stored transcripts unreadable, which is the intended property.
#
# Rotating: put the new pair first and keep the old ones after it. New writes use the first;
# old rows still open under the key their stored id names. Remove an old key only once no row
# names it — a removed key that is still in use fails reads with an error naming its id:
#
#   SELECT key_id, count(*) FROM call_transcript_entries GROUP BY key_id;
#   SELECT key_id, count(*) FROM call_summaries GROUP BY key_id;
#
# Transcripts age out within 90 days (the retention ceiling), so a transcript key is free to
# go that long after it stopped being first. Summaries never age out, so a key that sealed one
# stays for as long as that summary does.
TRANSCRIPT_ENCRYPTION_KEYS=

# How long transcripts are kept is each user's own preference (default 7 days, 1 to 90), not
# a deployment setting. Run the purge on a schedule, at least daily:
#
#   uv run letmehandle-purge

# ---------------------------------------------------------------------------
# Language model  (phase 6)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint: a hosted API, an aggregator, or a local server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Realtime speech  (phase 5)
# ---------------------------------------------------------------------------
# Which protocol the speech service speaks: `realtime` (the default) or `elevenlabs`.
#
#   realtime    Any service speaking the OpenAI Realtime-compatible websocket protocol: a hosted
#               API or a server you run yourself. SPEECH_MODEL names the model, and is sent as
#               the endpoint's `model` query parameter; the key is sent as a bearer header.
#   elevenlabs  An ElevenLabs agent. SPEECH_AGENT_ID names the agent, and is sent as the
#               endpoint's `agent_id` query parameter; the key is sent as an `xi-api-key` header.
#               For example, SPEECH_ENDPOINT_URL=wss://api.elevenlabs.io/v1/convai/conversation
#               (an example, not a default). The agent must allow these overrides in its
#               security settings: system prompt, first message, language and voice.
#
# All optional until something places a call; when set, the endpoint must be a ws:// or wss://
# URL. Leave the key empty for a service or a public agent that needs none.
SPEECH_PROVIDER=realtime
SPEECH_ENDPOINT_URL=
SPEECH_MODEL=
SPEECH_AGENT_ID=
# realtime only: the model that writes down what the caller says. Leave it empty and the
# conversation is answered but only the assistant's side is recorded.
SPEECH_TRANSCRIPTION_MODEL=
SPEECH_API_KEY=

# The voices this deployment offers, which must be voices the speech service above can speak —
# it decides what exists, not this project. REQUIRED: the process will not start without them.
#
#   id:Display name:locale|locale,id:Display name:locale
#
# Display names cannot contain a colon or a comma. The values below are EXAMPLES so that the
# application starts locally; no service speaks them. Replace them with your service's voices.
SPEECH_VOICES=example-voice-a:Example voice A (not a real voice):en,example-voice-b:Example voice B (not a real voice):en
# One of the ids above. A call whose user chose nothing is spoken in it.
SPEECH_DEFAULT_VOICE=example-voice-a

# ---------------------------------------------------------------------------
# Telephony  (phase 7)
# ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_NUMBER=
# The public base URL the provider calls back on. A tunnel in development.
TELEPHONY_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Notifications  (phase 10)
# ---------------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
