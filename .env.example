# Copy to .env and fill in. Nothing in this file ever carries a real value — not a key, not
# an account identifier, not a phone number, not even a "harmless" one. See D-021.
#
# Every variable here is read by the typed settings object in the backend and validated at
# startup. A missing required variable stops the process with a message naming it, rather
# than failing later in a way that is hard to trace.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | test | production. Guards behaviour that must never run in production,
# such as the mock one-time-password provider.
APP_ENV=development
# Host ports for the local stack. Change them if something else on your machine has them.
BACKEND_PORT=8000
POSTGRES_PORT=5432
LOG_LEVEL=info
# json in production, console in development.
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signs access tokens, and keys the hash refresh tokens are stored under. At least 32
# characters. Generate a fresh one per deployment and never reuse one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it signs everybody out, which is the intended behaviour if it has leaked.
AUTH_SIGNING_KEY=

# How long an access token lives. Short on purpose: it cannot be revoked, because it is
# verified by signature rather than by a database lookup. Between 60 and 3600 seconds.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# How long a refresh token lives. These can be revoked, and are rotated on every use. Sliding:
# each renewal starts the lifetime again, so a phone that opens the app within this long of the
# last time is never asked for its number again. Ninety days.
AUTH_REFRESH_TOKEN_TTL_SECONDS=7776000

# Who delivers the sign-in code. `mock` delivers nowhere and records the code instead, which
# is what lets the project be run and tested without a paid account — and it refuses to start
# when APP_ENV is production, because it would let anybody sign in as anybody.
#
# `twilio_sms` sends each code as a text message through the telephony provider's Messaging API,
# and is the provider a production deployment runs with. It needs the three SMS_ variables
# below, and the process refuses to start naming whichever are missing.
OTP_PROVIDER=mock

# The account the sign-in texts are sent from. Separate from the TELEPHONY_ account, which a
# deployment taking calls on a handset does not have; the same account's values work here too.
SMS_ACCOUNT_ID=
# That account's auth token. A secret: anyone holding it can send texts, and more, on the
# account. Never logged, never committed.
SMS_AUTH_TOKEN=
# The number the texts come from, in E.164 form. It must be able to send text messages to the
# countries your users sign in from.
SMS_FROM_NUMBER=

# Sign-in abuse (D-036). Every code sent costs money and reaches a phone, and SMS pumping earns from
# sending them. Country calling codes codes may be sent to, comma-separated without the plus, such
# as 91,1,44. Blank sends anywhere: fine for development, not for a production deployment, which
# should list only the countries it serves.
OTP_ALLOWED_CALLING_CODES=

# The deployment's hourly budget of codes, overall and to any one calling code. Past it, sign-in
# codes stop for everybody until the hour rolls on: a circuit breaker that costs sign-ins rather
# than a bill. Set them above your real peak, and alert on `auth.challenge.refused` with
# outcome=budget or outcome=country_budget.
OTP_CHALLENGES_PER_HOUR=500
OTP_CHALLENGES_PER_HOUR_PER_CALLING_CODE=100

# The load balancers or proxies in front of the backend, as comma-separated CIDRs. Only a request
# arriving from one of these has its X-Forwarded-For believed when counting what one client asks
# for. Blank trusts no header, which is right when nothing sits in front of the backend and makes
# every client look like the proxy when something does.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Privacy  (phase 8)
# ---------------------------------------------------------------------------
# Application-layer encryption keys for transcripts and call summaries (AES-256-GCM), as
# `id:key` pairs, comma-separated, NEWEST FIRST. An id is 1-16 lower-case letters, digits, -
# or _; a key is 32 random bytes in base64:
#
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Needed only by what stores or reads transcripts; migrations and the purge run without it.
# Losing every key makes stored transcripts unreadable, which is the intended property.
#
# Rotating: put the new pair first and keep the old ones after it. New writes use the first;
# old rows still open under the key their stored id names. Remove an old key only once no row
# names it — a removed key that is still in use fails reads with an error naming its id:
#
#   SELECT key_id, count(*) FROM call_transcript_entries GROUP BY key_id;
#   SELECT key_id, count(*) FROM call_summaries GROUP BY key_id;
#   SELECT key_id, count(*) FROM calls GROUP BY key_id;
#   SELECT key_id, count(*) FROM escalation_contexts WHERE key_id IS NOT NULL GROUP BY key_id;
#
# Transcripts age out within 90 days (the retention ceiling), so a transcript key is free to
# go that long after it stopped being first. Summaries never age out, so a key that sealed one
# stays for as long as that summary does.
TRANSCRIPT_ENCRYPTION_KEYS=

# How long transcripts are kept is each user's own preference (default 7 days, 1 to 90), not
# a deployment setting. Run the purge on a schedule, at least daily:
#
#   uv run letmehandle-purge

# ---------------------------------------------------------------------------
# Language model  (phase 6)
# ---------------------------------------------------------------------------
# The model the agent judges calls with: any OpenAI-compatible endpoint — a hosted API, an
# aggregator, or a server you run yourself. Optional to start the backend; required, all three,
# for the agent to judge a call. A server that checks no key accepts any value for LLM_API_KEY.
# For example, LLM_BASE_URL=http://127.0.0.1:8080/v1 (an example, not a default).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Extra headers some gateways ask for, as `Header-Name=value;Other-Header=value`. A value cannot
# contain a semicolon, and Authorization cannot be set here: the key is sent in it.
LLM_HEADERS=
# How long one judgement may take, in seconds, every model turn and tool included. A caller is
# waiting on the line; past this the agent falls back to "could not understand the caller".
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Realtime speech  (phase 5)
# ---------------------------------------------------------------------------
# Which protocol the speech service speaks: `realtime` (the default) or `elevenlabs`.
#
#   realtime    Any service speaking the OpenAI Realtime-compatible websocket protocol: a hosted
#               API or a server you run yourself. SPEECH_MODEL names the model, and is sent as
#               the endpoint's `model` query parameter; the key is sent as a bearer header.
#   elevenlabs  An ElevenLabs agent. SPEECH_AGENT_ID names the agent, and is sent as the
#               endpoint's `agent_id` query parameter; the key is sent as an `xi-api-key` header.
#               For example, SPEECH_ENDPOINT_URL=wss://api.elevenlabs.io/v1/convai/conversation
#               (an example, not a default). The agent must allow these overrides in its
#               security settings: system prompt, first message, language and voice.
#
# All optional until something places a call; when set, the endpoint must be a ws:// or wss://
# URL. Leave the key empty for a service or a public agent that needs none.
SPEECH_PROVIDER=realtime
# The languages the speech service speaks, comma-separated, such as `en,hi`. A call opens in the
# user's language when it is listed here, and in English otherwise (D-039). An ElevenLabs agent
# that speaks more than one needs its language detection tool and a language preset, with a
# voice, for each language other than its own.
SPEECH_LANGUAGES=en
SPEECH_ENDPOINT_URL=
SPEECH_MODEL=
SPEECH_AGENT_ID=
# realtime only: the model that writes down what the caller says. Leave it empty and the
# conversation is answered but only the assistant's side is recorded.
SPEECH_TRANSCRIPTION_MODEL=
SPEECH_API_KEY=

# The voices this deployment offers, which must be voices the speech service above can speak —
# it decides what exists, not this project. REQUIRED: the process will not start without them.
#
#   id:Display name:locale|locale,id:Display name:locale
#
# A call is spoken in a voice listed for the language it opens in (D-039), so a deployment taking
# calls in Hindi lists one for `hi`, for example:
#
#   voice-id-a:An English voice:en|en-IN,voice-id-b:A Hindi voice:hi
#
# Display names cannot contain a colon or a comma. The values below are EXAMPLES so that the
# application starts locally; no service speaks them. Replace them with your service's voices.
# Quoted, because a display name has spaces and not every reader of this file allows them bare.
SPEECH_VOICES="example-voice-a:Example voice A (not a real voice):en,example-voice-b:Example voice B (not a real voice):en"
# One of the ids above. A call whose user chose nothing is spoken in it.
SPEECH_DEFAULT_VOICE=example-voice-a

# ---------------------------------------------------------------------------
# Telephony  (phase 7)
# ---------------------------------------------------------------------------
# Which call transport carries calls: `twilio` for streaming calls over a programmable telephony
# account, `android_native` for calls screened on the user's own handset, or empty for none.
# Empty is a supported deployment, and so is `android_native`: neither mounts the streaming call
# routes nor needs anything below. With `twilio` every variable below is required, and the
# process refuses to start naming what is missing. Handsets' call reports are accepted whichever
# is chosen. Either transport also needs DATABASE_URL and TRANSCRIPT_ENCRYPTION_KEYS: calls are
# recorded as they happen, and the process refuses to start without somewhere to record them.
# See docs/providers/call-transport.md for both, and for what to create in the provider's console.
TELEPHONY_PROVIDER=
# The account identifier that authenticates calls to the provider's API. Never commit one.
TELEPHONY_ACCOUNT_ID=
# The account's auth token. A secret: it signs every callback this service receives, so anyone
# holding it can impersonate the provider. Never logged, never committed.
TELEPHONY_AUTH_TOKEN=
# The provider numbers calls are placed from, comma-separated, in E.164 form. The first is used
# when the number a caller dialled is not one of them.
TELEPHONY_NUMBERS=
# The identifier of the provider-side application whose voice URL is this service's assistant
# webhook. The assistant joins each call through it.
TELEPHONY_APP_ID=
# The public base URL the provider calls back on, without a trailing path: a tunnel in
# development. Signatures are checked against this, not against the Host a request arrives
# with, so it must be exactly what the provider was configured to call.
TELEPHONY_WEBHOOK_BASE_URL=
# Development only: the signed-in number whose calls dialled straight at the account's number are,
# for trying a deployment without setting up forwarding. Refused in production.
TELEPHONY_UNFORWARDED_CALLS_OWNER=

# How long a call may last, in seconds, before it is ended and recorded as failed. A handset
# whose report of a call ending never arrives would otherwise leave the call held until the
# process restarts. Between 60 and 86400; four hours by default.
CALL_MAX_DURATION_SECONDS=14400

# ---------------------------------------------------------------------------
# Notifications  (phase 10)
# ---------------------------------------------------------------------------
# Push notifications that tell the user why their phone is ringing when the assistant needs them.
# Both platforms are optional and independent. Without them escalation still works: the phone
# rings, and the app fetches the context itself. Set every variable of a platform or none of it;
# a platform half set stops the process and names what is missing.
#
# iOS, delivered directly through Apple's push service with a token-signing key (a .p8 key from
# the Apple developer account, "Keys" section, with push notifications enabled).
#
# The 10-character key id shown beside the key.
APNS_KEY_ID=
# The 10-character team id of the developer account.
APNS_TEAM_ID=
# The .p8 file's content, including its BEGIN and END lines. On one line, write each newline as
# \n. A secret: never commit it, and prefer your secret store over this file.
APNS_PRIVATE_KEY=
# The app's bundle identifier, which is the topic notifications are sent to.
APNS_TOPIC=
# sandbox for development builds, production for TestFlight and App Store builds. No default: a
# device token from one is rejected by the other as invalid, and invalid tokens are removed.
APNS_ENVIRONMENT=
#
# Android, delivered directly through Firebase Cloud Messaging's HTTP v1 API.
#
# The Firebase project id.
FCM_PROJECT_ID=
# The service account's JSON key, as one line. It needs permission to send messages in the
# project above. A secret: never commit it, and prefer your secret store over this file.
FCM_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Observability  (phase 13)
# ---------------------------------------------------------------------------
# Where spans go: a collector's OTLP/HTTP traces URL, such as http://collector.internal:4318/v1/traces.
# Leave it empty to trace nowhere; nothing else changes. Spans carry call ids, states, timings and
# failure kinds, never what was said and never a number.
TRACING_OTLP_ENDPOINT=
# A bearer token of at least 32 characters for the diagnostics routes (/diagnostics/...), which
# list live calls, a call's timeline and every provider's latency. Leave it empty and those routes
# do not exist. Generate one as the signing key is generated, and keep it out of the app.
DIAGNOSTICS_TOKEN=
