<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The call state broadcast: ringing, off hook, idle. No number and no audio. Asked for with
         an explanation, and optional: without it only the screening decision is reported. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Installing a newer release of this app, and only that (update/SelfUpdater.kt, D-043). Its
         first use asks the user to allow installs from this app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- Bound by the platform, before an incoming call rings, while this app holds the
           call-screening role. Enabled from API 29, where that role exists. -->
      <service
        android:name=".calls.screening.RulesScreeningService"
        android:permission="android.permission.BIND_SCREENING_SERVICE"
        android:enabled="@bool/call_screening_supported"
        android:exported="true">
        <intent-filter>
            <action android:name="android.telecom.CallScreeningService" />
        </intent-filter>
      </service>

      <receiver
        android:name=".calls.events.PhoneStateReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.PHONE_STATE" />
        </intent-filter>
      </receiver>

      <!-- The result of an update install. Reached only through the pending intent the install
           session was committed with. -->
      <receiver
        android:name=".update.UpdateInstallResultReceiver"
        android:exported="false" />
    </application>
</manifest>
