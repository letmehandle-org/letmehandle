# Copy to apps/mobile/.env. Read at build time by react-native-config and validated at startup
# by src/config/environment.ts, which fails with the name of the offending variable.
#
# No real value belongs in this file — see D-021.

# development | staging | production
APP_ENV=development

# The backend, without a trailing slash. On an iOS simulator localhost is the host machine;
# on an Android emulator the host is reachable at 10.0.2.2.
API_BASE_URL=http://localhost:8000

# BCP 47 tag. English is the only shipped locale (D-017).
DEFAULT_LOCALE=en
