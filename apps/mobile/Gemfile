source 'https://rubygems.org'

# You may use http://rbenv.org/ or https://rvm.io/ to install and use this version
ruby ">= 2.6.10"

# Exclude problematic versions of cocoapods and activesupport that causes build failures.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
# The React Native template pins xcodeproj and concurrent-ruby below the versions that carry
# published advisories. Both pins were workarounds for incompatibilities that the current
# CocoaPods and Active Support no longer have, and keeping them means shipping a toolchain with
# known holes in it. Removed deliberately; if a pod install ever breaks because of it, the fix
# is the upstream version, not the pin.

# Ruby 3.4.0 has removed some libraries from the standard library.
gem 'bigdecimal'
gem 'logger'
gem 'benchmark'
gem 'mutex_m'
gem 'nkf'
