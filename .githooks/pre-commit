#!/usr/bin/env bash
# Runs the disclosure audit and gitleaks on the staged diff. Install: make hooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

# Nothing staged is not a commit worth checking.
git diff --cached --quiet && exit 0

if ! python3 scripts/disclosure_audit.py --staged; then
    printf '\n\033[31m  the commit was not made\033[0m\n'
    printf '  Staged content carries something that must not be published. See D-021 in\n'
    printf '  docs/architecture/decisions.md. Unstage or rewrite it — this is still free.\n\n'
    exit 1
fi

# gitleaks covers credential shapes the disclosure audit does not model.
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --redact --no-banner --config .gitleaks.toml; then
        printf '\n\033[31m  the commit was not made: gitleaks found a secret\033[0m\n\n'
        exit 1
    fi
fi
