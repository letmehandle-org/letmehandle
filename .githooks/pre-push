#!/usr/bin/env bash
# Audits every pushed commit, and runs make verify before main. Install: make hooks
set -uo pipefail

remote="${1:-origin}"
zero="0000000000000000000000000000000000000000"
gate=no
ranges=()

# Git describes each ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue    # a deletion builds nothing
    if [[ "$remote_sha" == "$zero" ]]; then
        # A new branch is audited for what the remote does not already have.
        ranges+=("$local_sha --not --remotes=$remote")
    else
        ranges+=("$remote_sha..$local_sha")
    fi
    if [[ "$remote_ref" == "refs/heads/main" ]]; then
        gate=yes
    fi
done

if ((${#ranges[@]})); then
    printf '\n\033[1mpre-push: checking what is about to be published\033[0m\n'
    for range in "${ranges[@]}"; do
        # Unquoted on purpose: a new-branch range is three arguments, not one.
        # shellcheck disable=SC2086
        if ! python3 scripts/disclosure_audit.py --range $range; then
            printf '\n\033[31m  nothing was pushed\033[0m\n'
            printf '  A commit message or an added line carries something that must not be\n'
            printf '  published. See D-021. The branch has not left this machine, so this is\n'
            printf '  still fixable by rewriting the commit. After a push it is not.\n\n'
            exit 1
        fi
    done
fi

[[ "$gate" == "yes" ]] || exit 0

printf '\n\033[1mpre-push: verifying before main\033[0m\n'
started="$SECONDS"
log="$(mktemp -t letmehandle-prepush)"
if make verify > "$log" 2>&1; then
    printf '\033[32m  verify passed\033[0m in %ds — pushing\n\n' "$((SECONDS - started))"
    rm -f "$log"
    exit 0
fi

printf '\n\033[31m  verify FAILED\033[0m after %ds — nothing was pushed\n\n' "$((SECONDS - started))"
tail -30 "$log" | sed 's/^/    /'
printf '\n  Full log: %s\n  Re-run with: make verify\n\n' "$log"
exit 1
